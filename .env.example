# Server Configuration
PORT=5000

# MongoDB Database Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/ndsc_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ndsc_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ndsc_db

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Initial Admin Credentials (auto-seeded if no admin exists)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Admin Gmail Address (Destination for contact messages & sender for OTP)
ADMIN_EMAIL=your_email@gmail.com

# Gmail 16-character App Password (Generated from Google Account -> Security -> App Passwords)
EMAIL_APP_PASSWORD=your_gmail_app_password
